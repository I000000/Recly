    "definitions": {
        "domain.User": {
            "type": "object",
            "properties": {
                "avatar_url": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "onboarding_completed": {
                    "type": "boolean"
                }
            }
        },
        "handler.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handler.RecommendRequest": {
            "type": "object",
            "required": [
                "direction",
                "selected_ids"
            ],
            "properties": {
                "contextual": {
                    "type": "boolean"
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "book_to_movie",
                        "book_to_book",
                        "movie_to_movie",
                        "movie_to_book"
                    ]
                },
                "exclude_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "selected_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "weights": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "number",
                        "format": "float64"
                    }
                }
            }
        },
        "handler.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "name",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                }
            }
        },
        "handler.SaveRecommendationRequest": {
            "type": "object",
            "required": [
                "from_id",
                "from_type",
                "to_id",
                "to_type"
            ],
            "properties": {
                "from_id": {
                    "type": "string"
                },
                "from_type": {
                    "type": "string",
                    "enum": [
                        "book",
                        "movie"
                    ]
                },
                "to_id": {
                    "type": "string"
                },
                "to_type": {
                    "type": "string",
                    "enum": [
                        "book",
                        "movie"
                    ]
                }
            }
        },
        "handler.recordViewRequest": {
            "type": "object",
            "required": [
                "item_id",
                "item_type"
            ],
            "properties": {
                "item_id": {
                    "type": "string"
                },
                "item_type": {
                    "type": "string",
                    "enum": [
                        "book",
                        "movie"
                    ]
                }
            }
        },
        "redis.RecommendationResult": {
            "type": "object",
            "properties": {
                "contextual": {
                    "type": "boolean"
                },
                "created_at": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "movies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "status": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
